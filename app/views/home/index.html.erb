<h1>Welcome</h1>
<img src="https://uploads.mangadex.org/covers/e64b54c4-5ef4-44d3-85db-09fe0d3e513c/ca176324-2e24-4d37-aa13-21220cf743d9.png" id="targetImg"/>
<div id="img">
</div>
<script>
  placeholder = document.querySelector("#img");
  img = document.querySelector("#targetImg");
  imgSrc = img.getAttribute("src");

  const getBase64StringFromDataURL = (dataURL) =>
    dataURL.replace('data:', '').replace(/^.+,/, '');

  fetch(imgSrc)
    .then((res) => res.blob())
    .then((blob) => {
      const reader = new FileReader();
      reader.onloadend = () => {
        console.log(reader.result);
        const base64 = getBase64StringFromDataURL(reader.result);
        console.log(base64);

        const newImg = new Image();
        newImg.src = reader.result;
        console.log(newImg);
        placeholder.appendChild(newImg);
      };
      reader.readAsDataURL(blob);

    });

</script>
