<h1>Welcome</h1>
<img src="https://uploads.mangadex.org/covers/e64b54c4-5ef4-44d3-85db-09fe0d3e513c/ca176324-2e24-4d37-aa13-21220cf743d9.png" id="targetImg"/>
<div id="img">
</div>
<script>
  placeholder = document.querySelector("#img");
  img = document.querySelector("#targetImg");
  imgSrc = img.getAttribute("src");
  newImg = document.createElement("img");
  newImg.src = imgSrc;
  placeholder.appendChild(newImg);
</script>
